{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gcp-key-restrictions output",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "dryRun", "keys", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt":   { "type": "string", "format": "date-time" },
    "dryRun":        { "type": "boolean" },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project", "uid", "displayName", "outcome", "before"],
        "properties": {
          "project":     { "type": "string" },
          "uid":         { "type": "string" },
          "displayName": { "type": "string" },
          "outcome":     { "enum": ["applied", "flagged", "skipped"] },
          "reason":      { "type": "string" },
          "before":      { "type": ["object", "null"] },
          "after":       { "type": ["object", "null"] },
          "rollback":    { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["context", "message"],
        "properties": {
          "context": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
