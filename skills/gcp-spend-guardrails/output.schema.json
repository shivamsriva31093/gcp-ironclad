{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gcp-spend-guardrails output",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "dryRun", "actions", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt":   { "type": "string", "format": "date-time" },
    "dryRun":        { "type": "boolean" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "target", "outcome", "details", "rollback"],
        "properties": {
          "kind":     { "enum": ["set_quota", "create_budget", "recommend_spend_cap", "disable_idle_api"] },
          "target":   { "type": "string" },
          "outcome":  { "enum": ["applied", "skipped", "flagged"] },
          "reason":   { "type": "string" },
          "details":  { "type": "object" },
          "rollback": { "type": "string" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["context", "message"],
        "properties": {
          "context": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
